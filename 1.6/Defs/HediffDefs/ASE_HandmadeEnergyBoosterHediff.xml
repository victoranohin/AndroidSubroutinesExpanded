<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_HandmadeEnergyBoosterHediff</defName>
    <label>handmade reactor</label>
    <description>Hand-assembled, extremely rare and fragile experimental reactor model provides incredible power efficiency and work speed, but the android cannot be repaired after damage.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.9, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>100</initialSeverity>
    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
      </li>
    </stages>
  </HediffDef>
</Defs>