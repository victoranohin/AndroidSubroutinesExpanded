<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_DecentralizedMindHediff</defName>
    <label>decentralized mind network</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Distributed computing allows even load distribution across all android CPUs present on the map, increasing their efficiency.</description>
    <defaultLabelColor>(0.2, 0.8, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>1 node (+10% work speed)</label>
        <becomeVisible>true</becomeVisible>
        <statOffsets>
          <WorkSpeedGlobal>0.10</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>2 nodes (+20% work speed)</label>
        <statOffsets>
          <WorkSpeedGlobal>0.20</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>3 nodes (+30% work speed)</label>
        <statOffsets>
          <WorkSpeedGlobal>0.30</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>4 nodes (+40% work speed)</label>
        <statOffsets>
          <WorkSpeedGlobal>0.40</WorkSpeedGlobal>
        </statOffsets>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <label>5+ nodes (+50% work speed)</label>
        <statOffsets>
          <WorkSpeedGlobal>0.50</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>