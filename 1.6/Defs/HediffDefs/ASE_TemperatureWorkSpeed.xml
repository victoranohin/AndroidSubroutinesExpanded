<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>ASE_TemperatureWorkSpeed</defName>
    <label>temperature work adaptation</label>
    <description>Work efficiency varies with ambient temperature. +2% work speed per degree below 20°C, -2% per degree above 20°C.</description>
    <hediffClass>AndroidSubroutinesExpanded.Hediff_TemperatureWorkSpeed</hediffClass>
    <defaultLabelColor>(0.8, 0.8, 1.0)</defaultLabelColor>
    <makesSickThought>false</makesSickThought>
    <maxSeverity>3.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    
    <stages>
      <!-- Dynamic hediff with a single stage -->
      <li>
        <minSeverity>0.0</minSeverity>
        <label>temperature adaptation</label>
        <statOffsets>
          <WorkSpeedGlobal>0.0</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
