<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_SilverOverlayHediff</defName>
    <label>silver overlay</label>
    <description>A special silver coating has been applied to the android's armor. Makes the android noticeably stronger.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.4, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>100</initialSeverity>
    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
      </li>
    </stages>
  </HediffDef>
</Defs>