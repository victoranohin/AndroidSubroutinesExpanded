<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_TacticalNetworkHediff</defName>
    <label>tactical network</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Real-time tactical data exchange allows androids to fight more effectively.</description>
    <defaultLabelColor>(1.0, 0.6, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>1 node (+5% combat stats)</label>
        <becomeVisible>true</becomeVisible>
        <statOffsets>
          <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
          <MeleeDodgeChance>0.05</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.05</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>2 nodes (+10% combat stats)</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
          <MeleeDodgeChance>0.10</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.10</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>3 nodes (+15% combat stats)</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.15</ShootingAccuracyPawn>
          <MeleeDodgeChance>0.15</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.15</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>4 nodes (+20% combat stats)</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.20</ShootingAccuracyPawn>
          <MeleeDodgeChance>0.20</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.20</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <label>5+ nodes (+25% combat stats)</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.25</ShootingAccuracyPawn>
          <MeleeDodgeChance>0.25</MeleeDodgeChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.25</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>