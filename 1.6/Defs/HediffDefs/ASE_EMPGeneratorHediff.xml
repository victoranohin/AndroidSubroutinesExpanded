<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_EMPGeneratorHediff</defName>
    <label>EMP reactor</label>
    <description>This experimental reactor produces a decent amount of energy, but its core periodically provokes EMP bursts that can negatively affect other androids and mechanisms.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.9, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>100</initialSeverity>
    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
      </li>
    </stages>
  </HediffDef>
</Defs>