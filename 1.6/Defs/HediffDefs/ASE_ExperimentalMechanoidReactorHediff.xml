<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_ExperimentalMechanoidReactorHediff</defName>
    <label>experimental mechanoid reactor</label>
    <description>Further increasing the reactor's energy efficiency led to an unexpected effect - its high frequency attracts other mechanoids.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 1.0, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>100</initialSeverity>
    <stages>
      <li>
        <label>active</label>
        <becomeVisible>true</becomeVisible>
      </li>
    </stages>
  </HediffDef>
</Defs>