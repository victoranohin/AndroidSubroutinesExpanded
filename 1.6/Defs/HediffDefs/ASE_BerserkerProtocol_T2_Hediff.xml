<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>ASE_BerserkerProtocol_T2_Hediff</defName>
    <label>berserker protocol T2</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Further development of the protocol created for public entertainment: the more damaged the android is, the more ferociously it fights. Due to imperfect technology, it may enter uncontrollable rage and become a threat to everything alive within 1 kilometer (including your colonists).</description>
    <defaultLabelColor>(1.0, 0.3, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>100</maxSeverity>
    <initialSeverity>0.1</initialSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>stable</label>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
        <minSeverity>10</minSeverity>
        <label>warming up (+20% attack speed)</label>
      </li>
      <li>
        <minSeverity>25</minSeverity>
        <label>frenzied (+50% attack speed)</label>
      </li>
      <li>
        <minSeverity>50</minSeverity>
        <label>raging (+100% attack speed)</label>
      </li>
      <li>
        <minSeverity>75</minSeverity>
        <label>berserk (+150% attack speed)</label>
      </li>
    </stages>
  </HediffDef>
</Defs>